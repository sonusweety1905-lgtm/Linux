pipeline{
      agent any
        stages{
           stage('Build'){
                 steps{
                     echo 'Building Java application'
                     sh 'javac Hello.java'
                  }
             }
         stage('Test'){
                 steps{
                     echo 'Testing Java application'
                     sh 'java Hello'
                  }
             }
         stage('Depoly'){
                 steps{
                     echo 'Deploying Java application'
                     echo 'Application deployed successfully'
                  }
             }
        }
}
